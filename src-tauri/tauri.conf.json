{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moodframe",
  "version": "1.0.0",
  "identifier": "com.moodframe.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Moodframe",
      "width": 1280,
      "height": 850,
      "minWidth": 900,
      "minHeight": 600,
      "decorations": false,
      "backgroundColor": "#111111"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../resources/icon.ico", "../resources/icon.png"],
    "resources": { "../native/frameviewer/media-runtime/": "media/" },
    "shortDescription": "Your folders, as moodboards"
  }
}
